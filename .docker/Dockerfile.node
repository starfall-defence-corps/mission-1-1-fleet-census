FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# Install systemd + SSH + Ansible prerequisites
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    openssh-server \
    python3 \
    python3-apt \
    sudo \
    iproute2 \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Mask unnecessary systemd units that cause issues in containers
RUN systemctl mask \
    dev-hugepages.mount \
    sys-fs-fuse-connections.mount \
    systemd-udev-trigger.service \
    systemd-udevd.service \
    systemd-update-utmp.service \
    systemd-logind.service \
    getty@.service \
    getty.target

# Enable SSH via systemd
RUN systemctl enable ssh

# Configure SSH — root login enabled (Saboteur Chmod-777 misconfiguration)
RUN mkdir -p /run/sshd \
    && sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config

# Create cadet user for SSH access
RUN useradd -m -s /bin/bash cadet \
    && echo 'cadet:academy' | chpasswd \
    && echo 'cadet ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers.d/cadet \
    && chmod 0440 /etc/sudoers.d/cadet

# Set up SSH key auth for cadet
RUN mkdir -p /home/cadet/.ssh \
    && chmod 700 /home/cadet/.ssh \
    && chown cadet:cadet /home/cadet/.ssh

# Set root password (insecure — deliberate misconfiguration for training)
RUN echo 'root:starfall' | chpasswd

# Plant Saboteur Chmod-777's evidence — files with 777 permissions
RUN mkdir -p /opt/fleet-data \
    && printf '%s\n' \
       "CLASSIFIED: Fleet encryption key register — DO NOT DISTRIBUTE" \
       "==============================================================" \
       "SDC Cyber Command — key custodian: Lt. Mara Voss, Signals Div." \
       "Rotation policy: every 30 cycles. Last rotation: cycle 4471." \
       "Register entries: sdc-web (slot 1), sdc-db (slot 2), sdc-comms (slot 3)." \
       "(Training replica — all entries fictional, no live key material.)" \
       "ARIA NOTE: if any crew member can read this file, Saboteur" \
       "Chmod-777 has been aboard. Report the permissions, not the contents." \
       > /opt/fleet-data/encryption-keys.txt \
    && printf '%s\n' \
       "Fleet deployment manifest v3.2 — INTERNAL USE ONLY" \
       "===================================================" \
       "sdc-web    berth 12-A   forward relay, public-facing" \
       "sdc-db     berth 12-B   records vault, no direct approach" \
       "sdc-comms  berth 12-C   long-range array, EM-shielded" \
       "Next resupply window: cycle 4480, Tender SDC-Callisto." \
       "(Training replica — vessels and berths are fictional.)" \
       > /opt/fleet-data/deployment-manifest.txt \
    && printf '%s\n' \
       "Crew rotation schedule — RESTRICTED" \
       "====================================" \
       "First watch:  Ens. Toll, Spc. Imari      (cycles 4470-4474)" \
       "Middle watch: Lt. Voss, Ens. Okonkwo     (cycles 4475-4479)" \
       "Dog watch:    Spc. Halloran, Ens. Toll   (cycles 4480-4484)" \
       "(Training replica — roster is fictional.)" \
       > /opt/fleet-data/crew-rotation.txt \
    && chmod 777 /opt/fleet-data/encryption-keys.txt \
    && chmod 777 /opt/fleet-data/deployment-manifest.txt \
    && chmod 777 /opt/fleet-data/crew-rotation.txt

EXPOSE 22

STOPSIGNAL SIGRTMIN+3

CMD ["/sbin/init"]
